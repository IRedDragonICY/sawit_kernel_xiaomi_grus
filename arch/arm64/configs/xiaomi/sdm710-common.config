# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# exFAT
CONFIG_EXFAT_FS=y

# Haptics
CONFIG_LEDS_QPNP_HAPTICS=n
CONFIG_INPUT_QTI_HAPTICS=y

# HZ
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y

# initramfs
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# IR
CONFIG_MEDIA_RC_SUPPORT=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

# LKMD (Low-Memory-Killer-Daemon) dependencies
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_PSI=y

# Net
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# TCP BBRv3 congestion control
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# CONFIG_TCP_CONG_CUBIC is not set
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# pstore
CONFIG_CMDLINE="ramoops_memreserve=4M"
CONFIG_CMDLINE_EXTEND=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_SQ=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_BLOCK2MTD=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# USB ConfigFS
CONFIG_USB_CONFIGFS_F_UVC=y

# vDSO
# CONFIG_COMPAT_VDSO is not set
CONFIG_BPF_SYSCALL=y
CONFIG_HARDEN_BRANCH_PREDICTOR=y
CONFIG_EXPERT=y

# ── CPU errata disabled (not present on SDM710 A75+A55) ──
# A53
# CONFIG_ARM64_ERRATUM_826319 is not set
# CONFIG_ARM64_ERRATUM_827319 is not set
# CONFIG_ARM64_ERRATUM_824069 is not set
# CONFIG_ARM64_ERRATUM_819472 is not set
# CONFIG_ARM64_ERRATUM_845719 is not set
# CONFIG_ARM64_ERRATUM_843419 is not set

# A57
# CONFIG_ARM64_ERRATUM_832075 is not set

# A57/A72
# CONFIG_ARM64_ERRATUM_1742098 is not set

# A76
# CONFIG_ARM64_ERRATUM_1188873 is not set

# Cavium ThunderX
# CONFIG_CAVIUM_ERRATUM_22375 is not set
# CONFIG_CAVIUM_ERRATUM_23154 is not set
# CONFIG_CAVIUM_ERRATUM_27456 is not set

# QDF2400 server
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set
