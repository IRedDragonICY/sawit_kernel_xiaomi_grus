# Extreme Clang Optimization Config for SDM710 (Kryo 360 / Cortex-A75+A55)
# Requires: LLVM=1 LLVM_IAS=1 with Clang 14+ and ld.lld
#
# LTO via gold + LLVMgold (the original design for kernel 4.9).
# ld.lld LTO breaks section ordering / exception tables on 4.9 → stuck logo.
# gold handles 4.9 kernel LTO correctly (used by Google/Qualcomm in production).
# gc-sections still disabled — gold + gc-sections can delete needed sections.

CONFIG_LTO_CLANG=y
# CONFIG_LD_DEAD_CODE_DATA_ELIMINATION is not set

# ── ARMv8.2-A Hardware Optimizations ──
# LSE atomics: NOT compatible with Clang on kernel 4.9
# The alternatives framework uses fixed-size .org padding that breaks
# with Clang's code generation (invalid .org offset errors in spinlock.h)
# CONFIG_ARM64_LSE_ATOMICS is not set

# ── Static Keys (JUMP_LABEL) ──
# Converts runtime branch checks into NOPs/unconditional jumps
# Eliminates branch prediction overhead on hot paths (tracepoints, static branches)
# ARM64 has HAVE_ARCH_JUMP_LABEL — this is a free significant perf win
CONFIG_JUMP_LABEL=y

# ── I/O Scheduler: deadline for flash/UFS storage ──
# CFQ is designed for rotational disks — sorts requests by seek position
# Deadline is optimal for flash/UFS: no seek penalty, lowest latency
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_CFQ is not set
# CONFIG_DEFAULT_NOOP is not set

# ── Timer: 300Hz (balanced) ──
# 300Hz is already good for phone. 1000Hz adds timer interrupt overhead
# for marginal latency improvement. Keep 300Hz for battery balance.

# ── Scheduler tuning ──
# Disable scheduler statistics collection — adds overhead on every context switch
# CONFIG_SCHEDSTATS is not set

# ── Disable frame pointer for ~2% perf gain ──
# Saves x29 push/pop in every function prologue/epilogue
# Stack traces use DWARF unwinding instead (slightly less reliable in oops)
# CONFIG_FRAME_POINTER is not set

# ── Disable debug bloat for production builds ──
# CONFIG_DEBUG_INFO is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCKDEP is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_HARDLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set

# ── Disable unused kernel debug/profiling overhead ──
# CONFIG_KASAN is not set
# CONFIG_KCOV is not set
# CONFIG_KGDB is not set
# CONFIG_PROFILING is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_BLK_DEV_IO_TRACE is not set

# ── Performance-oriented options ──
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
